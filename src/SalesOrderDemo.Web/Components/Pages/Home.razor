@page "/"
@using SalesOrderDemo.Application.Interfaces
@inject IDashboardService DashboardService

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h3" Class="mb-4">Dashboard</MudText>

@if (_dashboard == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.h6">Total Orders</MudText>
                    <MudText Typo="Typo.h3">@_dashboard.TotalOrders</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.h6">Total Customers</MudText>
                    <MudText Typo="Typo.h3">@_dashboard.TotalCustomers</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.h6">Total Products</MudText>
                    <MudText Typo="Typo.h3">@_dashboard.TotalProducts</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.h6">Total Revenue</MudText>
                    <MudText Typo="Typo.h3">@_dashboard.TotalRevenue.ToString("C")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mt-4">
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.h6">Pending</MudText>
                    <MudText Typo="Typo.h4">@_dashboard.PendingOrders</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.h6">Processing</MudText>
                    <MudText Typo="Typo.h4">@_dashboard.ProcessingOrders</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.h6">Shipped</MudText>
                    <MudText Typo="Typo.h4">@_dashboard.ShippedOrders</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.h6">Delivered</MudText>
                    <MudText Typo="Typo.h4">@_dashboard.DeliveredOrders</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudPaper Class="mt-4 pa-4" Elevation="2">
        <MudText Typo="Typo.h5" Class="mb-4">Recent Orders</MudText>
        <MudTable Items="@_dashboard.RecentOrders" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>Order Number</MudTh>
                <MudTh>Customer</MudTh>
                <MudTh>Order Date</MudTh>
                <MudTh>Amount</MudTh>
                <MudTh>Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Order Number">@context.OrderNumber</MudTd>
                <MudTd DataLabel="Customer">@context.CustomerName</MudTd>
                <MudTd DataLabel="Order Date">@context.OrderDate.ToString("d")</MudTd>
                <MudTd DataLabel="Amount">@context.TotalAmount.ToString("C")</MudTd>
                <MudTd DataLabel="Status">@context.Status</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private SalesOrderDemo.Application.DTOs.DashboardDto? _dashboard;

    protected override async Task OnInitializedAsync()
    {
        _dashboard = await DashboardService.GetDashboardDataAsync();
    }
}
